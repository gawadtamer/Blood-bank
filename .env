# رابط الباك إند الخاص بالتطوير (Local API)
# قم بتغييره عندما يعطيك مطور الباك إند الرابط الحقيقي
VITE_API_BASE_URL=http://localhost:5000/api

# مفتاح التبديل للبيانات المؤقتة:
# true  => استخدام البيانات المحلية (LocalStorage) لتجربة التطبيق بدون باك إند
# false => الاتصال بالباك إند الحقيقي مباشرة عبر الرابط أعلاه
VITE_USE_MOCK_DATA=true
